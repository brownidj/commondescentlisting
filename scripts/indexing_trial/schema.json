                    }
                  },
                  "year": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "journal_or_publisher": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "doi": {
                    "type": [
